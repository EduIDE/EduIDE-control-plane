{
  "name": "eduide-landing-page",
  "version": "1.0.0",
  "description": "Landing page of the EduIDE control plane (experimental)",
  "license": "EPL-2.0 OR GPL-2.0 WITH Classpath-exception-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/EduIDE/EduIDE-control-plane.git",
    "directory": "landing-page"
  },
  "homepage": "https://github.com/EduIDE/EduIDE-control-plane/tree/main/landing-page#readme",
  "bugs": {
    "url": "https://github.com/EduIDE/EduIDE-control-plane/issues"
  },
  "keywords": [
    "cloud",
    "kubernetes",
    "landing-page",
    "react",
    "vite",
    "education"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "sync-client": "rm -rf src/api-client && mkdir -p src/api-client && cp ../clients/typescript/src/index.ts ../clients/typescript/src/schema.gen.ts src/api-client/",
    "check-client": "npm run sync-client && git diff --exit-code -- src/api-client"
  },
  "dependencies": {
    "dompurify": "^3.4.18",
    "keycloak-js": "26.2.5",
    "lucide-react": "^0.577.0",
    "marked": "^18.2.1",
    "openapi-fetch": "0.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-no-null": "^1.0.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  }
}
